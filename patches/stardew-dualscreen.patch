+jint Java_org_yuzu_yuzu_1emu_NativeLibrary_fillStardewCompanionSnapshot(
+    JNIEnv* env, jobject instance, jobject output) {
+    if (!output) {
+        return -1;
+    }
+    void* address = env->GetDirectBufferAddress(output);
+    const jlong capacity = env->GetDirectBufferCapacity(output);
+    if (!address || capacity <= 0) {
+        return -1;
+    }
+    return StardewCompanion::FillSnapshot(EmulationSession::GetInstance(), address,
+                                           static_cast<std::size_t>(capacity));
+}
+
 jboolean Java_org_yuzu_yuzu_1emu_NativeLibrary_performPlzaCompanionAction(
     JNIEnv* env, jobject instance, jint action, jint argument) {
     return PlzaCompanion::PerformAction(EmulationSession::GetInstance(), action, argument)
diff --git a/src/android/app/src/main/jni/stardew_companion.cpp b/src/android/app/src/main/jni/stardew_companion.cpp
new file mode 100644
index 0000000..6fd5c9f
--- /dev/null
+++ b/src/android/app/src/main/jni/stardew_companion.cpp
@@ -0,0 +1,127 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "jni/stardew_companion.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstring>
+#include <string>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "core/core.h"
+#include "jni/native.h"
+
+namespace StardewCompanion {
+namespace {
+
+constexpr u64 TitleId = 0x0100E65002BB8000ULL;
+constexpr u32 Magic = 0x56534453; // "SDSV" in the little-endian snapshot.
+
+enum class Status : u32 {
+    NotRunning = 0,
+    WrongTitle = 1,
+    WaitingForGame = 2,
+    ProfileRequired = 3,
+    Active = 4,
+};
+
+#pragma pack(push, 1)
+struct SnapshotFrame {
+    u32 magic;
+    u16 version;
+    u16 size;
+    u32 sequence;
+    u32 status;
+    std::array<u8, 0x20> build_id;
+    u64 main_base;
+    u64 main_size;
+    s32 day;
+    s32 time_of_day;
+    s32 money;
+    float stamina;
+    float max_stamina;
+    s32 health;
+    s32 max_health;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(SnapshotFrame) == 92);
+
+std::atomic<u32> Sequence{0};
+std::atomic<u64> LoggedProcessId{0};
+
+bool HasBuildId(const std::array<u8, 0x20>& build_id) {
+    return std::any_of(build_id.begin(), build_id.end(), [](u8 value) { return value != 0; });
+}
+
+void LogDetectedBuild(Core::System& system, const SnapshotFrame& frame) {
+    const auto* process = system.ApplicationProcess();
+    const u64 process_id = process ? process->GetProcessId() : 0;
+    if (!process_id || LoggedProcessId.exchange(process_id, std::memory_order_relaxed) == process_id) {
+        return;
+    }
+    std::string build;
+    build.reserve(frame.build_id.size() * 2);
+    constexpr char Hex[] = "0123456789ABCDEF";
+    for (const u8 byte : frame.build_id) {
+        build.push_back(Hex[byte >> 4]);
+        build.push_back(Hex[byte & 0x0F]);
+    }
+    while (build.size() >= 2 && build.ends_with("00")) {
+        build.resize(build.size() - 2);
+    }
+    LOG_INFO(Frontend,
+             "[Stardew Companion] Detected title={:016X} build={} main={:#x}+{:#x}; "
+             "a memory profile is required",
+             TitleId, build, frame.main_base, frame.main_size);
+}
+
+} // namespace
+
+int FillSnapshot(EmulationSession& session, void* output, std::size_t output_size) {
+    if (!output || output_size < sizeof(SnapshotFrame)) {
+        return -static_cast<int>(sizeof(SnapshotFrame));
+    }
+
+    SnapshotFrame frame{};
+    frame.magic = Magic;
+    frame.version = 1;
+    frame.size = sizeof(frame);
+    frame.sequence = Sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+    frame.status = static_cast<u32>(Status::NotRunning);
+
+    if (!session.IsRunning()) {
+        std::memcpy(output, &frame, sizeof(frame));
+        return sizeof(frame);
+    }
+
+    auto& system = session.System();
+    if (system.GetApplicationProcessProgramID() != TitleId) {
+        frame.status = static_cast<u32>(Status::WrongTitle);
+        std::memcpy(output, &frame, sizeof(frame));
+        return sizeof(frame);
+    }
+
+    const auto [main_base, main_size] = system.GetApplicationProcessMainModule();
+    frame.main_base = main_base;
+    frame.main_size = main_size;
+    frame.build_id = system.GetApplicationProcessBuildID();
+    if (!main_base || !main_size || !HasBuildId(frame.build_id)) {
+        frame.status = static_cast<u32>(Status::WaitingForGame);
+    } else {
+        // Live values intentionally remain disabled until this exact build has a verified
+        // pointer/offset profile. This prevents an update from turning arbitrary guest bytes
+        // into plausible-looking player data.
+        frame.status = static_cast<u32>(Status::ProfileRequired);
+        LogDetectedBuild(system, frame);
+    }
+
+    std::memcpy(output, &frame, sizeof(frame));
+    return sizeof(frame);
+}
+
+} // namespace StardewCompanion
