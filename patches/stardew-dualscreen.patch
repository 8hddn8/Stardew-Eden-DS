+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+package org.yuzu.yuzu_emu.activities
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.View
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.TimeUnit
+import org.yuzu.yuzu_emu.NativeLibrary
+
+internal class StardewCompanionView(context: Context) : View(context) {
+    private companion object {
+        private const val SNAPSHOT_SIZE = 92
+        private const val SNAPSHOT_MAGIC = 0x56534453
+        private const val POLL_INTERVAL_MS = 250L
+        private const val STATUS_WAITING = 2
+        private const val STATUS_PROFILE_REQUIRED = 3
+        private const val STATUS_ACTIVE = 4
+    }
+
+    private val snapshot = ByteBuffer.allocateDirect(SNAPSHOT_SIZE).order(ByteOrder.LITTLE_ENDIAN)
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val bold = Typeface.create("sans-serif", Typeface.BOLD)
+    private val normal = Typeface.create("sans-serif", Typeface.NORMAL)
+    private var poller: ScheduledExecutorService? = null
+
+    @Volatile private var status = 0
+    @Volatile private var buildId = ""
+    @Volatile private var day = 0
+    @Volatile private var timeOfDay = 0
+    @Volatile private var money = 0
+    @Volatile private var stamina = 0f
+    @Volatile private var maxStamina = 0f
+    @Volatile private var health = 0
+    @Volatile private var maxHealth = 0
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        poller = Executors.newSingleThreadScheduledExecutor { runnable ->
+            Thread(runnable, "StardewCompanion").apply { isDaemon = true }
+        }.also {
+            it.scheduleWithFixedDelay(::pollSnapshot, 0, POLL_INTERVAL_MS, TimeUnit.MILLISECONDS)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        poller?.shutdownNow()
+        poller = null
+        super.onDetachedFromWindow()
+    }
+
+    private fun pollSnapshot() {
+        snapshot.clear()
+        if (NativeLibrary.fillStardewCompanionSnapshot(snapshot) != SNAPSHOT_SIZE) return
+        snapshot.rewind()
+        if (snapshot.int != SNAPSHOT_MAGIC) return
+        snapshot.short // version
+        snapshot.short // size
+        snapshot.int // sequence
+        val nextStatus = snapshot.int
+        val buildBytes = ByteArray(32)
+        snapshot.get(buildBytes)
+        snapshot.long // main base (logged natively; deliberately not shown in normal UI)
+        snapshot.long // main size
+        val nextDay = snapshot.int
+        val nextTime = snapshot.int
+        val nextMoney = snapshot.int
+        val nextStamina = snapshot.float
+        val nextMaxStamina = snapshot.float
+        val nextHealth = snapshot.int
+        val nextMaxHealth = snapshot.int
+        val lastBuildByte = buildBytes.indexOfLast { it.toInt() != 0 }
+        val nextBuildId = if (lastBuildByte >= 0) {
+            buildBytes.copyOfRange(0, lastBuildByte + 1).joinToString("") { "%02X".format(it) }
+        } else {
+            ""
+        }
+
+        status = nextStatus
+        buildId = nextBuildId
+        day = nextDay
+        timeOfDay = nextTime
+        money = nextMoney
+        stamina = nextStamina
+        maxStamina = nextMaxStamina
+        health = nextHealth
+        maxHealth = nextMaxHealth
+        postInvalidateOnAnimation()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        canvas.drawColor(Color.rgb(36, 25, 39))
+        val scale = minOf(width / 1240f, height / 1080f)
+        val left = (width - 1240f * scale) / 2f
+        val top = (height - 1080f * scale) / 2f
+        canvas.save()
+        canvas.translate(left, top)
+        canvas.scale(scale, scale)
+
+        paint.typeface = bold
+        paint.color = Color.rgb(255, 226, 150)
+        paint.textSize = 70f
+        canvas.drawText("STARDEW VALLEY", 70f, 110f, paint)
+        paint.typeface = normal
+        paint.color = Color.rgb(230, 213, 189)
+        paint.textSize = 31f
+        canvas.drawText("Eden DS companion", 74f, 154f, paint)
+
+        if (status == STATUS_ACTIVE) drawHud(canvas) else drawSetup(canvas)
+        canvas.restore()
+    }
+
+    private fun drawSetup(canvas: Canvas) {
+        card(canvas, 65f, 220f, 1110f, 690f)
+        paint.typeface = bold
+        paint.color = Color.WHITE
+        paint.textSize = 48f
+        val title = when (status) {
+            STATUS_PROFILE_REQUIRED -> "Gioco rilevato"
+            STATUS_WAITING -> "Caricamento di Stardew Valley…"
+            else -> "In attesa del gioco…"
+        }
+        canvas.drawText(title, 110f, 310f, paint)
+
+        paint.typeface = normal
+        paint.color = Color.rgb(221, 210, 197)
+        paint.textSize = 31f
+        if (status == STATUS_PROFILE_REQUIRED) {
+            canvas.drawText("Questa build richiede il profilo di memoria.", 110f, 382f, paint)
+            canvas.drawText("Copia il Build ID riportato sotto per la calibrazione:", 110f, 430f, paint)
+            paint.typeface = Typeface.MONOSPACE
+            paint.color = Color.rgb(255, 226, 150)
+            paint.textSize = 28f
+            canvas.drawText(buildId.ifEmpty { "lettura in corso…" }, 110f, 505f, paint)
+            paint.typeface = normal
+            paint.color = Color.rgb(183, 225, 179)
+            paint.textSize = 27f
+            canvas.drawText("Eden_Log.txt contiene lo stesso identificativo.", 110f, 570f, paint)
+        } else {
+            canvas.drawText("Avvia Stardew Valley e carica un salvataggio.", 110f, 390f, paint)
+        }
+    }
+
+    private fun drawHud(canvas: Canvas) {
+        card(canvas, 65f, 220f, 1110f, 700f)
+        paint.typeface = bold
+        paint.color = Color.WHITE
+        paint.textSize = 52f
+        canvas.drawText("Giorno $day   ${formatTime(timeOfDay)}", 110f, 315f, paint)
+        paint.color = Color.rgb(255, 226, 150)
+        canvas.drawText("${money}g", 900f, 315f, paint)
+        meter(canvas, "Energia", stamina, maxStamina, 110f, 420f, Color.rgb(97, 190, 113))
+        meter(canvas, "Salute", health.toFloat(), maxHealth.toFloat(), 110f, 555f, Color.rgb(207, 75, 78))
+    }
+
+    private fun meter(canvas: Canvas, label: String, value: Float, max: Float, x: Float, y: Float, color: Int) {
+        paint.typeface = bold
+        paint.color = Color.WHITE
+        paint.textSize = 31f
+        canvas.drawText("$label  ${value.toInt()} / ${max.toInt()}", x, y, paint)
+        val bounds = RectF(x, y + 28f, x + 900f, y + 76f)
+        paint.color = Color.rgb(63, 51, 65)
+        canvas.drawRoundRect(bounds, 18f, 18f, paint)
+        val fraction = if (max > 0f) (value / max).coerceIn(0f, 1f) else 0f
+        paint.color = color
+        val fill = RectF(
+            bounds.left,
+            bounds.top,
+            bounds.left + bounds.width() * fraction,
+            bounds.bottom
+        )
+        canvas.drawRoundRect(fill, 18f, 18f, paint)
+    }
+
+    private fun card(canvas: Canvas, x: Float, y: Float, width: Float, height: Float) {
+        paint.color = Color.rgb(52, 39, 55)
+        canvas.drawRoundRect(RectF(x, y, x + width, y + height), 34f, 34f, paint)
+    }
+
+    private fun formatTime(raw: Int): String = "%02d:%02d".format(raw / 100, raw % 100)
+}
